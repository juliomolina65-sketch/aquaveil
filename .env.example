# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is git-ignored and must never be uploaded or shared.
# On Railway, put these same names under the service's Variables tab instead.

# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Test mode: set STRIPE_MODE=test and fill these (Stripe → toggle "Test mode" → API keys).
# Fake orders with card 4242 4242 4242 4242, any future date, any CVC. No money moves.
STRIPE_MODE=live
STRIPE_TEST_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe → Product catalog → The Aquaveil Showerhead (already set as the default)
STRIPE_PRODUCT_ID=prod_VFW8AzNpBAaiwi

# Port for local runs (Railway sets its own)
PORT=5540
